{
    "name": "@sg/sg-game-client",
    "version": "1.0.10-beta.1",
    "type": "commonjs",
    "types": "dist/index.d.ts",
    "main": "dist/index.js",
    "license": "UNLICENSED",
    "files": [
        "dist/"
    ],
    "author": {
        "email": "pentagon@luminetsoft.com",
        "name": "pentagon"
    },
    "scripts": {
        "start": "tsc --watch",
        "build": "tsc",
        "test": "jest unit-tests",
        "integration-test": "jest integration-tests/index.test.ts",
        "test-coverage": "jest unit-tests --collect-coverage",
        "posttest-coverage-with-cocos": "npm run build && cd examples/cocos-3x && npm install && npm run test-coverage",
        "test:watch": "jest --watch --verbose",
        "start-simulator": "docker compose -f \"examples/server-simulator/docker-compose.yml\" up -d --build",
        "reg": "npm set registry http://npm.lumigame.com",
        "pub": "tsc && npm publish --registry http://npm.lumigame.com",
        "betaver": "npm version prerelease --preid beta",
        "pubbeta": "tsc && npm publish --registry http://npm.lumigame.com --tag beta",
        "semantic-release": "semantic-release",
        "generate-tolgee-data": "ts-node ./tolgee-generator/index.ts",
        "load-tolgee-data": "ts-node ./tolgee-generator/load-tolgee-realtime.ts",
        "create-beta-package": "npm version prerelease --preid beta && tsc && npm publish --registry http://npm.lumigame.com --tag beta"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "dependencies": {
        "@sg/sg-user-service-client": "1.8.5",
        "base64-string": "^1.1.2",
        "eventemitter2": "6.4.9",
        "inversify": "6.0.1",
        "lodash": "^4.17.21",
        "mobx-logger": "^0.7.1",
        "moment": "^2.29.4",
        "node-polyglot": "^2.5.0",
        "socket.io-client": "4.6.1",
        "socket.io-msgpack-parser": "^3.0.2",
        "unique-names-generator": "^4.7.1"
    },
    "devDependencies": {
        "@semantic-release/changelog": "^5.0.1",
        "@semantic-release/commit-analyzer": "^8.0.1",
        "@semantic-release/git": "^9.0.0",
        "@semantic-release/gitlab": "^6.0.4",
        "@semantic-release/npm": "^7.0.5",
        "@semantic-release/release-notes-generator": "^9.0.1",
        "@tolgee/web": "^5.10.1",
        "@types/jest": "29.5.0",
        "@types/socket.io-client": "^3.0.0",
        "jest": "29.5.0",
        "jest-auto-stub": "^1.0.8",
        "jest-environment-jsdom": "^29.5.0",
        "jest-junit": "15.0.0",
        "jest-sonar-reporter": "2.0.0",
        "mobx": "6.9.0",
        "prettier": "2.8.7",
        "reflect-metadata": "0.1.13",
        "sc-semantic-release": "^1.2.0",
        "semantic-release": "^17.1.1",
        "socket.io-mock-ts": "^1.0.2",
        "ts-jest": "29.1.0",
        "ts-node": "10.9.1",
        "typescript": "5.0.4"
    }
}